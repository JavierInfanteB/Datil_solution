# Copia este archivo a .env (NO se sube a Git) y cambia los valores.
#   PowerShell:  Copy-Item .env.example .env
# Genera secretos largos, p. ej.:  python -c "import secrets; print(secrets.token_urlsafe(32))"

POSTGRES_DB=datil_db
POSTGRES_USER=datil_owner
POSTGRES_PASSWORD=cambia-esta-clave-del-propietario
DATIL_APP_PASSWORD=cambia-esta-clave-de-la-app
DATIL_READONLY_PASSWORD=cambia-esta-clave-de-solo-lectura

# Puertos en tu computadora (host), publicados solo en 127.0.0.1. Los 5000 son de salida (API) y los 8000 de bases de datos.
DB_HOST_PORT=8002
API_HOST_PORT=5005

# Clave para firmar los JWT (obligatoria)
SECRET_KEY=cambia-esta-clave-jwt

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
BANXICO_TOKEN=
